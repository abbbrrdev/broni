generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  number    String   @unique
  city      String
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  originalText   String
  taskName       String
  placeName      String
  placeNumber    String?
  address        String?
  time           String?
  additionalInfo String?
  status         String   @default("PENDING")
  callOutcome    String?
  callSummary    String?
  callStatus     String?
  recordingUrl   String?
  recordingSid   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Company {
  id           String    @id @default(cuid())
  name         String
  sipNumber    String    @unique
  email        String?   @unique
  password     String?
  systemPrompt String
  crmConfig    String?   // JSON settings for CRM integration
  isActive     Boolean   @default(true)
  callLogs     CallLog[]
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CallLog {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  clientPhone    String?
  direction      String   @default("INBOUND")
  audioRecordUrl String?
  transcript     String?
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Booking {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  clientName  String
  clientPhone String
  date        DateTime
  service     String?
  status      String   @default("CONFIRMED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
